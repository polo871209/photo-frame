+  static ClientCert parseClientCert(String host, String keyB64, String certB64)
+      throws GeneralSecurityException {
+    if (host == null) throw new IllegalArgumentException("saved URL has no host");
+    X509Certificate cert = (X509Certificate) CertificateFactory.getInstance("X.509")
+        .generateCertificate(new ByteArrayInputStream(Base64.decode(certB64, Base64.DEFAULT)));
+    String algorithm = cert.getPublicKey().getAlgorithm();
+    PrivateKey key = KeyFactory.getInstance(algorithm)
+        .generatePrivate(new PKCS8EncodedKeySpec(Base64.decode(keyB64, Base64.DEFAULT)));
+    String signatureAlgorithm = "SHA256with" + ("EC".equals(algorithm) ? "ECDSA" : algorithm);
+    byte[] probe = host.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    Signature signer = Signature.getInstance(signatureAlgorithm);
+    signer.initSign(key);
+    signer.update(probe);
+    Signature verifier = Signature.getInstance(signatureAlgorithm);
+    verifier.initVerify(cert);
+    verifier.update(probe);
+    if (!verifier.verify(signer.sign())) throw new IllegalArgumentException("key does not match certificate");
+    return new ClientCert(host, key, cert);
+  }
