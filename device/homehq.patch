+  static final class ClientCert {
+    final String host;
+    final PrivateKey key;
+    final X509Certificate[] chain;
+
+    ClientCert(String host, PrivateKey key, X509Certificate cert) {
+      this.host = host;
+      this.key = key;
+      this.chain = new X509Certificate[] {cert};
+    }
+  }
+
+  /** Saves or forgets the client certificate from the intent. True if the saved one changed. */
+  private boolean saveClientCert(Intent intent) {
+    SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+    if (intent.getBooleanExtra("forget_client_cert", false)) {
+      prefs.edit().remove(PREF_CLIENT_KEY).remove(PREF_CLIENT_CERT).remove(PREF_CLIENT_CERT_HOST).apply();
+      clientCert = null;
+      WebView.clearClientCertPreferences(null);
+      Log.i(TAG, "Client certificate removed");
+      return true;
+    }
+    String key = intent.getStringExtra(PREF_CLIENT_KEY);
+    String cert = intent.getStringExtra(PREF_CLIENT_CERT);
+    if (key == null || cert == null) return false;
+    String host = Uri.parse(savedUrl()).getHost();
+    try {
+      clientCert = parseClientCert(host, key, cert);
+    } catch (GeneralSecurityException | IllegalArgumentException e) {
+      Log.w(TAG, "Ignoring client certificate: " + e.getClass().getSimpleName() + " " + e.getMessage());
+      return false;
+    }
+    prefs.edit().putString(PREF_CLIENT_KEY, key).putString(PREF_CLIENT_CERT, cert)
+        .putString(PREF_CLIENT_CERT_HOST, host).apply();
+    WebView.clearClientCertPreferences(null);
+    Log.i(TAG, "Client certificate saved for " + host + ", valid until " + clientCert.chain[0].getNotAfter());
+    return true;
+  }
+
+  private ClientCert savedClientCert() {
+    SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+    String host = prefs.getString(PREF_CLIENT_CERT_HOST, null);
+    String key = prefs.getString(PREF_CLIENT_KEY, null);
+    String cert = prefs.getString(PREF_CLIENT_CERT, null);
+    if (key == null || cert == null) return null;
+    try {
+      return parseClientCert(host, key, cert);
+    } catch (GeneralSecurityException | IllegalArgumentException e) {
+      Log.w(TAG, "Saved client certificate unusable: " + e.getClass().getSimpleName() + " " + e.getMessage());
+      return null;
+    }
+  }
+
+  /** The page calls HomeHQ.setBacklight(false) to dim the panel to its lowest level, and true to restore it. */
+  public final class Backlight {
+    @JavascriptInterface
+    public void setBacklight(boolean on) {
+      runOnUiThread(() -> {
+        WindowManager.LayoutParams attrs = getWindow().getAttributes();
+        attrs.screenBrightness = on ? WindowManager.LayoutParams.BRIGHTNESS_OVERRIDE_NONE : 0f;
+        getWindow().setAttributes(attrs);
+        Log.i(TAG, "Backlight " + (on ? "on" : "off"));
+      });
+    }
+  }
+
+  static ClientCert parseClientCert(String host, String keyB64, String certB64)
+      throws GeneralSecurityException {
+    if (host == null) throw new IllegalArgumentException("saved URL has no host");
+    X509Certificate cert = (X509Certificate) CertificateFactory.getInstance("X.509")
+        .generateCertificate(new ByteArrayInputStream(Base64.decode(certB64, Base64.DEFAULT)));
+    String algorithm = cert.getPublicKey().getAlgorithm();
+    PrivateKey key = KeyFactory.getInstance(algorithm)
+        .generatePrivate(new PKCS8EncodedKeySpec(Base64.decode(keyB64, Base64.DEFAULT)));
+    String signatureAlgorithm = "SHA256with" + ("EC".equals(algorithm) ? "ECDSA" : algorithm);
+    byte[] probe = host.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    Signature signer = Signature.getInstance(signatureAlgorithm);
+    signer.initSign(key);
+    signer.update(probe);
+    Signature verifier = Signature.getInstance(signatureAlgorithm);
+    verifier.initVerify(cert);
+    verifier.update(probe);
+    if (!verifier.verify(signer.sign())) throw new IllegalArgumentException("key does not match certificate");
+    return new ClientCert(host, key, cert);
