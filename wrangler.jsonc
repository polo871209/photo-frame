{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frame-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "routes": [{ "pattern": "photoframe.lochingpo.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "FRAME_CONTROL", "class_name": "FrameControl" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FrameControl"] }],
  "observability": { "enabled": true }
}
